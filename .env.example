# Local AI Gateway authentication. Vercel deployments can use project OIDC automatically.
AI_GATEWAY_API_KEY=

# Secure Jarvis system triggers.
# Set CRON_SECRET in Vercel production so scheduled jobs authenticate automatically.
CRON_SECRET=
# Used by future broker, TradingView, finance, messaging, and other webhook/event sources.
JARVIS_EVENT_SECRET=

# Persistent Jarvis storage (connect later through Supabase).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Future communication / voice providers.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# ELEVENLABS_API_KEY=

# --- Owner login (required in production) ---
# Passcode for the JARVIS owner login page. Without it, production refuses all access.
JARVIS_OWNER_PASSCODE=
# Optional separate signing secret for owner sessions (16+ chars). Defaults to a value derived from the passcode.
JARVIS_SESSION_SECRET=

# --- Durable storage (server only) ---
# Required for permanent trade history, device pairing, command queue and learning data.
# After setting it, run supabase/migrations/*.sql and check /api/system/storage.
# SUPABASE_SERVICE_ROLE_KEY= (see above)

# --- Learning pipeline ---
# Shared secret placed inside TradingView alert messages that feed bars and shadow signals.
JARVIS_MARKET_WEBHOOK_SECRET=
