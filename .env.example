# =============================================================================
# JARVIS — environment template
# Copy to `.env.local` and fill in. NEVER commit a filled-in copy.
# Validated at startup by src/lib/env.ts — the app refuses to boot on bad config.
# =============================================================================

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
# development | preview | production
APP_ENV=development
# debug | info | warn | error
LOG_LEVEL=debug
# Absolute URL of this deployment. Used for links in notifications and auth
# redirects. Locally this is http://localhost:3000.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Data source
# -----------------------------------------------------------------------------
# `dev`      — in-memory repositories seeded with clearly-labeled MOCK data.
#              No Supabase credentials required. This is the v0.1 default.
# `supabase` — real Postgres via Supabase. Requires the keys below.
JARVIS_DATA_SOURCE=dev

# -----------------------------------------------------------------------------
# Supabase (required only when JARVIS_DATA_SOURCE=supabase)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
# Anon/publishable key. Safe for the browser ONLY because row-level security is
# enabled on every table. If you ever disable RLS, this key becomes a data leak.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key. Bypasses row-level security entirely.
# SERVER ONLY. Never expose it to the client, never prefix it with NEXT_PUBLIC_,
# and never use it to serve a user request that a user-scoped client could serve.
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Model provider (not used by v0.1 — reserved for the Ask Jarvis surface)
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=
