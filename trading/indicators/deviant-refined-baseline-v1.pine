//@version=6
indicator("DEVIANT - REFINED", overlay=true, max_bars_back=500)

// BASELINE SNAPSHOT — supplied by Dwight on 2026-09-16.
// Do not mutate this file in place. Future learned revisions should be versioned separately.

// === Inputs ===
cci_length = input.int(14, "CCI Length", group="Momentum")
cci_smooth = input.int(10, "CCI Smoothing", group="Momentum")
cci_threshold = input.float(30, "CCI Threshold", group="Momentum")
hma_period = input.int(34, "HMA Period", group="HMA")
hma_speed = input.float(1.5, "HMA Speed", group="HMA")
hma_lookback = input.int(10, "HMA Extreme Lookback", group="HMA")
ema_period = input.int(21, "EMA Period", group="Trend")
atr_period = input.int(14, "ATR Period", group="Volatility")
atr_mult = input.float(0.8, "ATR Multiplier", group="Volatility")
min_candle_body = input.float(10, "Min Candle Body (pts)", group="Precision")
max_arrows_per_day = input.int(3, "Max Arrows / Day", group="Limits")
session_start = input.int(8, "Session Start (NY)", group="Session")
session_end = input.int(15, "Session End (NY)", group="Session")

// === BANK LEVELS ===
show_levels = input.bool(true, "Show Bank Levels", group="Bank Levels")
level_step = input.float(250, "Level Spacing (pts)", group="Bank Levels")
wick_zone = input.float(80, "Wick Zone Radius (pts)", group="Bank Levels")
num_levels = input.int(8, "Levels to Draw", group="Bank Levels")
line_col = input.color(color.white, "Line Color", group="Bank Levels")
line_wid = input.int(1, "Line Width", group="Bank Levels")

// === BANK LEVEL MATH — every bar ===
level_below = math.floor(close / level_step) * level_step
level_above = level_below + level_step

long_wick_rejection = low <= level_below + wick_zone and close > level_below
short_wick_rejection = high >= level_above - wick_zone and close < level_above

// Draw levels — visual only
var line[] drawn_lines = array.new_line()
if barstate.islast and show_levels
    for l in drawn_lines
        line.delete(l)
    array.clear(drawn_lines)
    base = math.floor(close / level_step) * level_step
    for i = -(num_levels / 2) to num_levels / 2
        lvl = base + i * level_step
        l = line.new(bar_index, lvl, bar_index - 1, lvl,
             xloc=xloc.bar_index, extend=extend.both,
             color=line_col, width=line_wid, style=line.style_dashed)
        array.push(drawn_lines, l)

// === HMA ===
hma_calc(src, length, speed) =>
    wma1 = ta.wma(src, int(length / 2))
    wma2 = ta.wma(src, length)
    raw = 2 * wma1 - wma2
    ta.wma(raw, int(math.sqrt(length) * speed))

hma = hma_calc(close, hma_period, hma_speed)
hma_at_low = hma == ta.lowest(hma, hma_lookback)
hma_at_high = hma == ta.highest(hma, hma_lookback)
plot(hma, "HMA", color.yellow, 2)

// === EMA ===
ema = ta.ema(close, ema_period)
ema_bull = close > ema
ema_bear = close < ema
plot(ema, "EMA", color.red, 1)

// === CCI ===
cci = ta.cci(close, cci_length)
cci_ema = ta.ema(cci, cci_smooth)
cci_bull = cci_ema > cci_threshold
cci_bear = cci_ema < -cci_threshold

// === ATR ===
atr = ta.atr(atr_period)
candle_range = high - low
volatility_ok = candle_range > atr * atr_mult

// === CANDLE ===
body = math.abs(close - open)
strong_bull = close > open and body > min_candle_body
strong_bear = close < open and body > min_candle_body

// === SESSION ===
hour_ny = hour(time, "America/New_York")
in_session = hour_ny >= session_start and hour_ny < session_end

// === DAILY COUNTERS ===
var int daily_long_count = 0
var int daily_short_count = 0
new_day = ta.change(time("D", "America/New_York")) != 0
if new_day
    daily_long_count := 0
    daily_short_count := 0

// === SIGNALS ===
long_setup = long_wick_rejection and hma_at_low and strong_bull and (cci_bull or volatility_ok) and in_session and daily_long_count < max_arrows_per_day
short_setup = short_wick_rejection and hma_at_high and strong_bear and (cci_bear or volatility_ok) and in_session and daily_short_count < max_arrows_per_day

// === FIRING — original untouched ===
var bool long_fired = false
var bool short_fired = false
long_signal = long_setup and not long_fired
short_signal = short_setup and not short_fired

if long_signal
    daily_long_count += 1
    long_fired := true
if short_signal
    daily_short_count += 1
    short_fired := true

var int long_bar = 0
var int short_bar = 0
if long_signal
    long_bar := bar_index
if short_signal
    short_bar := bar_index

if bar_index - long_bar > 10
    long_fired := false
if bar_index - short_bar > 10
    short_fired := false

if not in_session
    long_fired := false
    short_fired := false

// === ARROWS ===
plotshape(long_signal, "LONG", shape.triangleup, location.belowbar, color.new(color.lime, 0), size=size.tiny)
plotshape(short_signal, "SHORT", shape.triangledown, location.abovebar, color.new(color.red, 0), size=size.tiny)

alertcondition(long_signal, "LONG", "DEVIANT LONG")
alertcondition(short_signal, "SHORT", "DEVIANT SHORT")
